[Unit]
Description=AS608 Fingerprint Bridge
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/SEHCS_WEB/pi_client
# Use the Python interpreter from the Desktop venv created as ~/Desktop/SEHCS
# Edit the --server and --device arguments as needed for your environment.
# Default device set to /dev/serial0 (friendly UART alias on Raspberry Pi)
ExecStart=/home/pi/Desktop/SEHCS/bin/python /home/pi/SEHCS_WEB/pi_client/fingerprint_sensor_bridge.py --server http://<FLASK_SERVER_IP>:5000 --device /dev/serial0 --poll 2.0
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
