[Unit]
Description=AS608 Fingerprint Bridge
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=raspi
WorkingDirectory=/home/raspi/Desktop/SEHCS
EnvironmentFile=/home/raspi/Desktop/SEHCS/.env
# Use the Python interpreter from the Desktop venv created as ~/Desktop/SEHCS
# Edit the --server and --device arguments as needed for your environment.
# Default device set to /dev/serial0 (friendly UART alias on Raspberry Pi)
ExecStart=/home/raspi/Desktop/SEHCS/bin/python /home/raspi/Desktop/SEHCS/pi_client/fingerprint_sensor_bridge.py --server ${FLASK_SERVER_URL} --device ${FINGERPRINT_DEVICE} --baudrate ${FINGERPRINT_BAUDRATE} --poll ${FINGERPRINT_POLL_SECONDS} --retries ${FINGERPRINT_RETRIES}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
