# Raspberry Pi -> Flask connection settings
# This file is documentation/configuration input for the Pi services.
# Replace the server IP with the Windows laptop IPv4 address.
# IMPORTANT: Set SEHCS_DEVICE_TOKEN to the same value from your Flask server .env file

FLASK_SERVER_URL=http://10.16.161.225:5000
SEHCS_DEVICE_TOKEN=replace-with-one-long-random-device-token

# Fall detector settings
BACKEND_API_URL=http://10.16.161.225:5000/api/fall-alerts
POSE_MODEL_PATH=/home/raspi/Desktop/SEHCS/yolov8n-pose.onnx
FALL_CAMERA=0
FALL_CAMERA_BACKEND=picamera2
FALL_CAPTURE_WIDTH=320
FALL_CAPTURE_HEIGHT=240
FALL_TARGET_FPS=10
FALL_THRESHOLD=0.70
FALL_ALERT_COOLDOWN_SECONDS=45
FALL_PERSON_DETECTION=1
FALL_STREAM_HOST=0.0.0.0
FALL_STREAM_PORT=8080
# Optional browser protection; if set, append ?token=<value> to FALL_STREAM_URL.
FALL_STREAM_TOKEN=
# Windows dashboard origin allowed to read /status, e.g. http://10.16.161.225:5000
FALL_DASHBOARD_ORIGIN=*

# Common AS608 serial device names: /dev/serial0, /dev/ttyUSB0, /dev/ttyAMA0
FINGERPRINT_DEVICE=/dev/serial0
FINGERPRINT_BAUDRATE=57600
FINGERPRINT_POLL_SECONDS=2
FINGERPRINT_RETRIES=5

# Voice service and Piper configuration
SEHCS_VOICE_BIND_HOST=0.0.0.0
SEHCS_VOICE_PORT=5051
SEHCS_VOICE_ENABLED=true
SEHCS_TTS_ENGINE=piper
SEHCS_PIPER_MODEL=/home/raspi/models/en_US-lessac-medium.onnx
# For Bluetooth/PipeWire speakers, use pw-play and leave the ALSA device empty.
SEHCS_AUDIO_PLAYER=pw-play
# Leave empty for the default ALSA device, or set e.g. plughw:0,0.
SEHCS_AUDIO_DEVICE=

# Example commands using the values above:
# python fingerprint_client.py --server "$FLASK_SERVER_URL" --id 7 --token "$SEHCS_DEVICE_TOKEN"
# python fingerprint_sensor_bridge.py --server "$FLASK_SERVER_URL" --device "$FINGERPRINT_DEVICE" --once --enroll-resident 7
# python fingerprint_sensor_bridge.py --server "$FLASK_SERVER_URL" --device "$FINGERPRINT_DEVICE" --once
