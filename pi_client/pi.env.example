# Raspberry Pi -> Flask connection settings
# This file is documentation/configuration input for the Pi services.
# Replace the server IP with the Windows laptop IPv4 address.
# IMPORTANT: Set FINGERPRINT_DEVICE_TOKEN to the same value from your Flask server .env file

FLASK_SERVER_URL=http://10.16.161.225:5000
FINGERPRINT_DEVICE_TOKEN=d7f9e2c1a8b3f5e4d6c2a9b1e7f3d5c8a2b4e6f8d1c3e5a7b9f2d4c6e8a0b

# Common AS608 serial device names: /dev/serial0, /dev/ttyUSB0, /dev/ttyAMA0
FINGERPRINT_DEVICE=/dev/serial0
FINGERPRINT_BAUDRATE=57600
FINGERPRINT_POLL_SECONDS=2
FINGERPRINT_RETRIES=5

# Example commands using the values above:
# python fingerprint_client.py --server "$FLASK_SERVER_URL" --id 7 --token "$FINGERPRINT_DEVICE_TOKEN"
# python fingerprint_sensor_bridge.py --server "$FLASK_SERVER_URL" --device "$FINGERPRINT_DEVICE" --once --enroll-resident 7
# python fingerprint_sensor_bridge.py --server "$FLASK_SERVER_URL" --device "$FINGERPRINT_DEVICE" --once
