# Copy this file to .env and fill in local values. Never commit .env.
GEMINI_API_KEY=replace-with-your-api-key
GEMINI_MODEL=replace-with-model-name
ANNOUNCEMENT_WINDOW_MINUTES=replace-with-minutes
MONITOR_INTERVAL_SECONDS=replace-with-seconds
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
BACKEND_API_HOST=127.0.0.1
# Optional override, useful when the detector runs on another machine.
# BACKEND_API_URL=http://127.0.0.1:5000/api/fall-alerts
FLASK_SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Strict
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://10.16.161.225:5173
ENABLE_DEBUG_ROUTES=0
AUTH_ALLOW_LEGACY_IDENTITY=0
SEHCS_DEVICE_TOKEN=replace-with-one-long-random-device-token
DB_HOST=replace-with-database-host
DB_PORT=replace-with-database-port
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
DB_NAME=replace-with-database-name
SEHCS_SERVER_VOICE_ENABLED=true
# Centralize Flask announcements on the Raspberry Pi speaker.
# Example: http://192.168.1.50:5051
SEHCS_VOICE_DEVICE_URL=
SEHCS_VOICE_DEVICE_TOKEN=
SEHCS_TTS_VOICE=en+f3
# Optional natural voice on the Pi: piper + a local .onnx voice model.
SEHCS_TTS_ENGINE=espeak
SEHCS_PIPER_MODEL=
SEHCS_AUDIO_PLAYER=aplay
# Fall detection configuration. Leave FALL_ALERT_DEFAULT_RESIDENT_ID empty
# unless this detector is permanently assigned to one known resident.
FALL_ALERT_DEFAULT_RESIDENT_ID=
FALL_ALERT_DEVICE_ID=main-camera
FALL_ALERT_LOCATION=
# Browser URL for the Pi MJPEG service, e.g. http://192.168.1.50:8080/stream.mjpg
FALL_STREAM_URL=