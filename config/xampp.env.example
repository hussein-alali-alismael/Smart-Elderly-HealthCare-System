# Flask + XAMPP MariaDB/MySQL configuration
# Copy these values into SEHCS_WEB/.env and replace placeholders.
# Never commit .env or real passwords.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# XAMPP commonly starts root with no password. Set this if you configured one.
DB_PASSWORD=
DB_NAME=elderly_healthcare_v3

# Bind Flask to all interfaces so the Raspberry Pi and React dev server can connect.
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
PORT=5000
BACKEND_API_HOST=127.0.0.1
# Optional override when the detector runs on another machine.
# BACKEND_API_URL=http://127.0.0.1:5000/api/fall-alerts
FLASK_SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=0
ENABLE_DEBUG_ROUTES=0
SEHCS_SERVER_VOICE_ENABLED=true

# Shared secret required by the Raspberry Pi fingerprint client.
# Generate a long random value and configure the same value on the Pi.
FINGERPRINT_DEVICE_TOKEN=replace-with-a-long-random-device-token

# Reminder worker
ANNOUNCEMENT_WINDOW_MINUTES=10
MONITOR_INTERVAL_SECONDS=300
DISABLE_NOTIFICATION_WORKER=0

# Optional Gemini chatbot configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Fall detection. Resident ID remains empty when the camera cannot identify a person.
FALL_ALERT_DEFAULT_RESIDENT_ID=
FALL_ALERT_DEVICE_ID=main-camera
FALL_ALERT_LOCATION=
# Browser URL for the Pi MJPEG service, e.g. http://192.168.1.50:8080/stream.mjpg
FALL_STREAM_URL=
